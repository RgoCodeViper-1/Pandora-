{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android Optimizer",
  "version": "0.1.0",
  "identifier": "com.dragon.androidoptimizer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dragon Android",
        "width": 1100,
        "height": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/dragon.ico", "icons/dragon.png"],
    "resources": ["config/rules.default.json"]
  }
}