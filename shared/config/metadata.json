    },
    "audio": {
      "inputDevice": null,
      "outputDevice": null,
      "sampleRate": 16000
    }
  },

  "modules": {
    "core": "1.0.0",
    "voice": {
      "vad": "1.0.0",
      "stt": "1.0.0",
      "tts": "1.0.0"
    },
    "logic": {
      "router": "1.0.0",
