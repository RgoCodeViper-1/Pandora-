  "apiKeys": {
    "openai": "",
    "anthropic": "",
    "groq": "",
    "google": "",
    "azure": "",
    "custom": ""
  },

  "security": {
    "shellExecution": false,
    "adminMode": false,
    "sandboxEnabled": true,
    "whitelistedCommands": [],
    "pluginSignatureRequired": false
  },

  "memory": {
    "enabled": true,
    "format": ["json", "markdown"],
    "paths": {
      "conversations": "shared/memory/conversations/",
      "state": "shared/memory/state/",
      "knowledge": "shared/memory/knowledge/",
      "tasks": "shared/memory/tasks/"
    },
    "maxSessions": 100,
    "autoPrune": true
  },

  "installer": {
    "productName": "PANDORA",
    "publisher": "Independent Build",
    "packageId": "pandora.desktop.assistant",
    "installPath": "C:/Program Files/PANDORA/",
    "portableMode": true,
    "autoStart": false,
    "desktopShortcut": true
  },

  "plugins": {
    "enabled": true,
    "path": "plugins/",
    "registry": [],
    "hotReload": false
  },

  "telemetry": {
    "enabled": false,
    "crashReports": false,
    "analytics": false
  },

  "paths": {
    "root": "./",
    "logs": "shared/logs/",
    "cache": "shared/cache/",
    "temp": "shared/temp/",
    "models": "python/models/",
    "config": "shared/config/"
