    "tasks": {
      "filesystem": "1.0.0",
      "web": "1.0.0",
      "system": "1.0.0"
    },
    "ui": "1.0.0"
  },

  "engines": {
    "vad": {
      "primary": "webrtcvad",
      "secondary": "silero-vad",
      "enabled": true
    },
    "stt": {
      "engine": "vosk",
      "fallback": "whisper",
      "streaming": true
    },
    "tts": {
      "engine": "edge-tts",
      "voice": "en-US-GuyNeural",
      "streaming": true
    },
    "llm": {
      "provider": "local",
      "model": null,
      "streaming": true
    }
