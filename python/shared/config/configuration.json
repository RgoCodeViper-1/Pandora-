{
  "system": {
    "name": "PANDORA",
    "mode": "development",
    "logLevel": "info",
    "version" : "1.0.0"
  },
  "audio": {
    "sampleRate": 16000,
    "vad": {
      "engine": "webrtc",
      "aggressiveness": 2,
      "silenceThresholdMs": 500,
      "useSilero": true,
      "sileroConfidenceThreshold": 0.5
    }
  },
  "speech": {
    "stt": {
      "engine": "vosk",
      "modelPath": "python/models/"
    },
    "tts": {
      "engine": "edge",
      "voice": "en-US-GuyNeural"
    }
  },
  "memory": {
    "enabled": true,
    "statePath": "shared/memory/state/runtime.json"
  }
}